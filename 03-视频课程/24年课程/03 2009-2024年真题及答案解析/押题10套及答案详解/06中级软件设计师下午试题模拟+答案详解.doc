\f4\fs24 \par \f4\fs24  \u160? \u160?\u20197?\u19979?C\u20195?\u30721?\u-28217?\u29992?\u-27394?\u24335?\u23384?\u20648?\u32467?\u26500?\u23454?\u29616?\u19968?\u20010?\u25972?\u25968?\u26632?\u25805?\u20316?\u12290?\f4\fs24 \par \f4\fs24 \u12304?C\u20195?\u30721?\u12305?\f4\fs24 \par \f4\fs24  \u160? \u160?typedef struct List \{\f4\fs24 \par \f4\fs24  \u160? \u160?int data\u-229? \u160? \u160? \u160? \u160? \u160? \u160? \u160? \u160? \u160?//\u26632?\u25968?\u25454?\f4\fs24 \par \f4\fs24  \u160? \u160?struct List* next\u-229? \u160? \u160? \u160? \u160? //\u19978?\u27425?\u20837?\u26632?\u30340?\u25968?\u25454?\u22320?\u22336?\f4\fs24 \par \f4\fs24  \u160? \u160?\}List\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160?typedef struct Stack\{\f4\fs24 \par \f4\fs24  \u160? \u160?List* pTop\u-229? \u160? \u160? \u160? \u160? \u160? \u160? \u160? \u160?//\u24403?\u21069?\u26632?\u-26506?\u25351?\u-27512?\f4\fs24 \par \f4\fs24  \u160? \u160?\}Stack\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? Stack* NewStack() \u160?\{return (Stack*) calloc(1/sizeof(Stack))\u-229?\}\f4\fs24 \par \f4\fs24  \u160? \u160?int IsEmpty(Stack* S)\{//\u21028?\u26029?\u26632?S\u26159?\u21542?\u20026?\u31354?\u26632?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?if(\f1\fs24\ul  \u160?(1) \u160?\ul0\f4\fs24 )return 1;\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?return 0;\f4\fs24 \par \f4\fs24  \u160? \u160?\}\f4\fs24 \par \f4\fs24  \u160? \u160?int Top(Stack* s)\{//\u-31817?\u21462?\u26632?\u-26506?\u25968?\u25454?\u12290?\u-32027?\u26632?\u20026?\u31354?\u-244?\u21017?\u-28716?\u22238?\u26426?\u22120?\u21487?\u-30616?\u31034?\u30340?\u26368?\u23567?\u25972?\u25968?\f4\fs24 \par \f4\fs24  \u160? \u160?if(IsEmpty(S))return INT_ MIN\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?return\f1\fs24\ul  \u160?(2) \u160?\ul0\f4\fs24 \u-229?\f4\fs24 \par \f4\fs24  \u160? \u160?\}\f4\fs24 \par \f4\fs24  \u160? \u160?void Push(Stack* S\u-244?int theData) \{//\u23558?\u25968?\u25454?theData\u21387?\u26632?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?List* newNode\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?newNode=(List*)calloc(1/sizeof (List))\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?newNode-\u-226?data=theData\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?newNode-\u-226?next=S-\u-226?pTop\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?S-\u-226?pTop=\f1\fs24\ul  \u160?(3) \u160?\ul0\f4\fs24 \u-229?\f4\fs24 \par \f4\fs24  \u160? \u160?\}\f4\fs24 \par \f4\fs24  \u160? \u160?void Pop(Stack* S) \u160?\{//\u24377?\u26632?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?List* lastTop\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?if(IsEmpty(S) \u160?) \u160?return\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?lastTop=S-\u-226?pTop\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?S-\u-226?pTop=\f1\fs24\ul  \u160?(4) \u160?\ul0\f4\fs24 \u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?free(lastTop)\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160?\}\f4\fs24 \par \f4\fs24  \u160? \u160?#define MD(a) \u160?a\u-228?\u-228?2\f4\fs24 \par \f4\fs24  \u160? \u160?int main()\{\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?int i;\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?Stack* myStack\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?myStack= NewStack()\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?Push(myStack\u-244?MD(1))\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?Push(myStack\u-244?MD(2))\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?Pop(myStack)\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?Push(myStack\u-244?MD(3)+1)\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160?while( !IsEmpty(myStack) \u160?)\{\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160? \u160? \u160? printf("%d"\u-244?Top(myStack))\u-229?\f4\fs24 \par \f4\fs24  \u160? \u160? \u160? \u160? \u160? \u160?Pop(myStack)\u-229?\f4\fs24 \par \f4\fs24  \u